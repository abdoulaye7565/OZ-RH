# Variables pour docker-compose.prod.yml — copier en « .env » à la racine du
# dépôt (lu automatiquement par `docker compose`), puis renseigner des valeurs
# réelles. Distinct de backend/.env (secrets applicatifs : JWT, Fernet, SMTP —
# voir backend/.env.example), copié et renseigné séparément.

# Identifiants PostgreSQL — choisir un mot de passe fort, propre à cet
# environnement (jamais "sheq"/"sheq", utilisé uniquement en développement).
POSTGRES_USER=sheq
POSTGRES_PASSWORD=
POSTGRES_DB=sheq

# URL PUBLIQUE de l'API, telle qu'accessible depuis le navigateur des
# utilisateurs (pas "api", le nom du service Docker — le navigateur ne
# résout pas les noms internes du réseau Docker). Compilée en dur dans les
# fichiers statiques du frontend à la construction de l'image : la modifier
# exige de reconstruire l'image frontend (`docker compose build frontend`).
# Exemple : https://sheq-api.hirondelles-it-lab.ml
VITE_API_URL=

# Ports publiés sur l'hôte (le reverse proxy de l'organisation, s'il existe,
# cible ces ports).
API_PORT=8000
WEB_PORT=8080

# Rappel : backend/.env doit lister l'URL publique du frontend ci-dessus dans
# CORS_ORIGINS, sans quoi l'API refusera les requêtes du navigateur.
# Exemple : CORS_ORIGINS=["https://sheq.hirondelles-it-lab.ml"]
