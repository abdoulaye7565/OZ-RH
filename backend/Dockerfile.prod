FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Pas de --reload (réservé au développement, backend/Dockerfile) : un
# rechargement à chaud n'a aucun sens sur une image immuable, et surveiller le
# système de fichiers en continu coûte des ressources inutiles en production.
# Un seul worker : le volume attendu (une PME) ne justifie pas la complexité
# d'une coordination multi-worker (APScheduler en tâche de fond dans le même
# processus, prompt 4.4 — plusieurs workers dupliqueraient les rappels
# planifiés sans coordination prévue pour l'éviter).
#
# Migrations appliquées au démarrage du conteneur (alembic upgrade head) :
# nécessaire sur les plateformes gérées (ex. Render) où il n'y a pas d'étape
# de déploiement séparée pour les lancer à la main. $PORT : certaines
# plateformes (Render) imposent le port d'écoute via cette variable ; 8000
# reste la valeur par défaut (docker-compose.prod.yml la fixe explicitement).
CMD alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}
