# Copier ce fichier en .env et renseigner des valeurs réelles.
# .env n'est jamais versionné (voir .gitignore).

ENVIRONMENT=development

# SQLite en développement, PostgreSQL en production (voir docker-compose.yml)
DATABASE_URL=sqlite:///./sheq.db

# Génération : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Clé maîtresse du coffre-fort (Fernet). Hors base de données, hors dépôt Git.
# Génération : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=

# Origines autorisées en CORS (tableau JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Dossier de stockage des pièces jointes, hors base de données
STORAGE_DIR=./storage

# Notifications (prompt 4.4) : serveur SMTP pour les courriels du tableau 3 du
# CDC (chapitre 6.3). Laisser SMTP_HOTE vide en développement : l'envoi est
# alors journalisé mais non tenté, la notification en application reste créée.
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=notifications@hirondelles-it-lab.local

# Planificateur de tâches (APScheduler) pour les rappels d'échéance périodiques
# (actions, EPI, inspections, documents). À désactiver uniquement pour du
# débogage ponctuel — les tests le désactivent déjà eux-mêmes.
SCHEDULER_ACTIF=true

# Service d'assistance IA (lot 6, chapitre 16 du CDC). Désactivé par défaut :
# à n'activer qu'après validation du budget par la direction (16.6). Laisser
# ASSISTANCE_API_CLE vide désactive de fait tout appel, même si
# ASSISTANCE_ACTIVEE=true (voir app/services/assistance/client.py).
ASSISTANCE_ACTIVEE=false
ASSISTANCE_API_CLE=
ASSISTANCE_MODELE=claude-haiku-4-5-20251001
ASSISTANCE_DELAI_MAX_SECONDES=10
# Vide = aucun plafond, aucune alerte automatique à l'administrateur.
ASSISTANCE_PLAFOND_MENSUEL_USD=

# Assistant documentaire (prompt 6.2) : indicateur propre à cette fonction
# (voir ASSISTANCE_ACTIVEE ci-dessus, les deux doivent être à true) et
# fournisseur d'embeddings — Anthropic n'en propose pas, Voyage AI est le
# partenaire qu'elle recommande elle-même.
ASSISTANCE_ASSISTANT_DOCUMENTAIRE_ACTIVE=false
ASSISTANCE_VOYAGE_API_CLE=
ASSISTANCE_MODELE_EMBEDDINGS=voyage-3-lite

# Pré-rédaction des rapports (prompt 6.4) : réutilise le client Anthropic
# ci-dessus, aucune clé supplémentaire.
ASSISTANCE_PRE_REDACTION_ACTIVE=false
